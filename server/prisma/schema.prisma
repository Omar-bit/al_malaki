// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  firstName        String
  lastName         String
  phoneNumber      String?
  birthDate        DateTime?
  profilePicture   String?
  role             Role
  passwordHash     String
  verifiedEmail    Boolean           @default(false)
  registerOtp      RegisterOtp?
  resetPasswordOtp ResetPasswordOtp?
  sentInvitations  UserInvitation[]  @relation("UserInvitations")
  orders           Order[]
  loyalty          CustomerLoyalty?
  contactMessages  ContactMessage[]
  notifications    Notification[]
  createdInfluencerTrackingLinks InfluencerTrackingLink[] @relation("CreatedInfluencerTrackingLinks")
  influencerTrackingLinkId       String?
  influencerTrackingLink         InfluencerTrackingLink?  @relation("InfluencerAttributedUsers", fields: [influencerTrackingLinkId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  influencerTrackedAt            DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([email])
  @@index([influencerTrackingLinkId])
}

model CustomerLoyalty {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  points            Int                  @default(0)
  totalPointsEarned Int                  @default(0)
  totalPointsSpent  Int                  @default(0)
  transactions      LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum LoyaltyTransactionType {
  EARN
  SPEND
}

model LoyaltyTransaction {
  id          String                 @id @default(uuid())
  loyaltyId   String
  loyalty     CustomerLoyalty        @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)
  type        LoyaltyTransactionType
  amount      Int
  description String?
  orderId     String?
  order       Order?                 @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loyaltyId])
  @@index([orderId])
}

model RegisterOtp {
  id                String   @id @default(uuid())
  email             String   @unique
  userId            String?  @unique
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  otpHash           String
  expiresAt         DateTime
  attemptsRemaining Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email, expiresAt])
  @@index([userId])
}

model ResetPasswordOtp {
  id                String   @id @default(uuid())
  email             String   @unique
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  otpHash           String
  expiresAt         DateTime
  attemptsRemaining Int      @default(5)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email, expiresAt])
  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
  VENDOR
}

enum NotificationType {
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  CONTACT_MESSAGE_CREATED
  CONTACT_MESSAGE_UPDATED
  SYSTEM
}

model UserInvitation {
  id          String    @id @default(uuid())
  email       String    @unique
  role        Role
  tokenHash   String    @unique
  invitedById String
  invitedBy   User      @relation("UserInvitations", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email, expiresAt])
  @@index([invitedById])
}

enum InfluencerTrackingStatus {
  ACTIVE
  DISABLED
}

model InfluencerTrackingLink {
  id               String                    @id @default(uuid())
  influencerName   String
  influencerHandle String?
  code             String                    @unique
  destinationPath  String                    @default("/")
  notes            String?
  status           InfluencerTrackingStatus  @default(ACTIVE)
  clicks           Int                       @default(0)
  lastClickedAt    DateTime?
  createdById      String
  createdBy        User                      @relation("CreatedInfluencerTrackingLinks", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  attributedUsers  User[]                    @relation("InfluencerAttributedUsers")
  attributedOrders Order[]                   @relation("InfluencerAttributedOrders")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([code])
  @@index([status])
  @@index([influencerName])
  @@index([createdById])
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum ProductPerformance {
  NEW_ARRIVAL
  RECOMMENDED
  FEATURED
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  image     String?
  color     String?
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
}

model Product {
  id               String             @id @default(uuid())
  name             String
  category         ProductCategory    @relation(fields: [categoryId], references: [id])
  categoryId       String
  brand            String?
  description      String?
  price            Float
  discountPrice    Float?
  images           Json               @default("[]")
  placement        Boolean              @default(false)
  collection       String?
  promoCode        String?
  campaign         String?
  status           ProductStatus      @default(ACTIVE)
  performance      ProductPerformance @default(NEW_ARRIVAL)
  slug             String             @unique
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  promoCodes PromoCode[]
  orderItems OrderItem[]

  @@index([slug])
  @@index([categoryId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
}

model Order {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status              OrderStatus          @default(PENDING)
  paymentMethod       PaymentMethod
  firstName           String
  lastName            String
  email               String
  phoneNumber         String
  secondPhone         String?
  address             String
  city                String
  postalCode          String
  subtotal            Float
  discount            Float                @default(0)
  packDiscount        Float                @default(0)
  pointsUsed          Int                  @default(0)
  total               Float
  giftMessage         String?              @db.Text
  promoCodeId         String?
  promoCode           PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items               OrderItem[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  loyaltyTransactions LoyaltyTransaction[]
  influencerTrackingLinkId String?
  influencerTrackingLink   InfluencerTrackingLink? @relation("InfluencerAttributedOrders", fields: [influencerTrackingLinkId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([promoCodeId])
  @@index([influencerTrackingLinkId])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productName String
  productSlug String
  image       String?
  price       Float
  quantity    Int
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromoCodeStatus {
  ACTIVE
  EXPIRED
  DISABLED
}

model PromoCode {
  id           String          @id @default(uuid())
  code         String          @unique
  discountType DiscountType
  value        Float
  usageLimit   Int? // per-user limit; null = unlimited
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  startDate    DateTime
  expiration   DateTime? // null = lifetime code
  isLifetime   Boolean         @default(false)
  source       String?
  totalUsage   Int             @default(0)
  totalRevenue Float           @default(0)
  status       PromoCodeStatus @default(ACTIVE)
  orders       Order[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([code])
  @@index([status])
  @@index([productId])
}

enum MessageStatus {
  UNREAD
  READ
  RESPONDED
}

model ContactMessage {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  phoneNumber String
  message     String
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ActivityLog {
  id          String   @id @default(uuid())
  actorId     String
  actorName   String?
  actorRole   Role?
  entityType  String
  entityId    String?
  action      String
  description String?
  changes     Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([entityType, action])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json             @default("{}")
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, type])
  @@index([createdAt])
}
