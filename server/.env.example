PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

DATABASE_URL=mysql://root:password@localhost:3306/al_malaki?allowPublicKeyRetrieval=true

JWT_ACCESS_SECRET=replace-with-a-strong-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=604800
JWT_COOKIE_MAX_AGE_MS=604800000

REGISTER_OTP_TTL_IN_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
