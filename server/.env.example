PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Set to true when running behind a reverse proxy (recommended same-domain deploy)
# so client IPs (rate limiting) and protocol are read from X-Forwarded-* headers.
TRUST_PROXY=false

DATABASE_URL=mysql://root:password@localhost:3306/al_malaki?allowPublicKeyRetrieval=true

# Redis connection for backend caching. If unset, an in-memory cache is used
# (fine for a single instance; not shared across replicas).
REDIS_URL=redis://localhost:6379
# Default cache TTL in milliseconds (public product/category listings).
CACHE_DEFAULT_TTL_MS=60000

# REQUIRED in production. Must be a strong, unique value (the app refuses to boot
# in production if this is missing or left as the example value).
JWT_ACCESS_SECRET=replace-with-a-strong-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=604800
JWT_COOKIE_MAX_AGE_MS=604800000

# Auth cookie behaviour.
# COOKIE_SAMESITE: lax (default, same-domain deploy) | strict | none (cross-site; forces Secure)
# COOKIE_SECURE:   true | false (defaults to true when NODE_ENV=production)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

REGISTER_OTP_TTL_IN_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_SUBJECT=Your AL MALAKI verification code
REGISTER_OTP_BRAND_NAME=AL MALAKI
REGISTER_OTP_EMAIL_HEADING=Verify your email address
REGISTER_OTP_EMAIL_INTRO=Use the following one-time passcode to complete your registration.

ADMIN_INVITE_TTL_HOURS=48
ADMIN_INVITE_URL_BASE=http://localhost:5173/invite/accept
ADMIN_INVITE_EMAIL_SUBJECT=You're invited to AL MALAKI
ADMIN_INVITE_BRAND_NAME=AL MALAKI

DEFAULT_ADMIN_EMAIL=admin@almalaki.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_FIRST_NAME=Super
DEFAULT_ADMIN_LAST_NAME=Admin
DEFAULT_ADMIN_PHONE_NUMBER=00000000
