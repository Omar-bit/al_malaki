# ------------------------------------------------------------------------------
# Root environment for docker-compose (production / Coolify).
# Copy to `.env` (kept out of git) or paste these into Coolify's env editor.
# Values marked REQUIRED have no safe default — the stack will not start without.
# ------------------------------------------------------------------------------

# --- Database (MariaDB container) ---
DB_NAME=al_malaki
DB_USER=malaki
DB_PASSWORD=change-me-strong-db-password        # REQUIRED
DB_ROOT_PASSWORD=change-me-strong-root-password  # REQUIRED

# --- Public origin ---
# Your real domain, e.g. https://almalaki.com (the one attached to `frontend`).
CLIENT_ORIGIN=https://your-domain.com

# The SPA calls the API same-origin via this prefix (nginx proxies it to the
# backend). Leave as /api unless you deploy the API on a separate domain.
VITE_API_BASE_URL=/api

# --- Auth / cookies (REQUIRED in production) ---
# Must be a strong, unique value >= 16 chars (NOT the example string).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=604800
JWT_COOKIE_MAX_AGE_MS=604800000
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Cache ---
CACHE_DEFAULT_TTL_MS=60000

# --- OTP ---
REGISTER_OTP_TTL_IN_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

# --- SMTP (email: OTP, admin invites) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_SUBJECT=Your AL MALAKI verification code
REGISTER_OTP_BRAND_NAME=AL MALAKI

# --- Admin invitations ---
ADMIN_INVITE_TTL_HOURS=48
ADMIN_INVITE_URL_BASE=https://your-domain.com/invite/accept
ADMIN_INVITE_EMAIL_SUBJECT=You're invited to AL MALAKI
ADMIN_INVITE_BRAND_NAME=AL MALAKI

# --- Default admin (seeded on first boot) ---
DEFAULT_ADMIN_EMAIL=admin@almalaki.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_FIRST_NAME=Super
DEFAULT_ADMIN_LAST_NAME=Admin
DEFAULT_ADMIN_PHONE_NUMBER=00000000
