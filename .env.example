# ------------------------------------------------------------------------------
# Root environment for docker-compose (production / Coolify).
# Copy to `.env` (kept out of git) or paste these into Coolify's env editor.
# Values marked REQUIRED have no safe default — the stack will not start without.
# ------------------------------------------------------------------------------

# --- Database (MySQL 8 container) ---
DB_NAME=al_malaki
DB_USER=malaki
DB_PASSWORD=change-me-strong-db-password        # REQUIRED
DB_ROOT_PASSWORD=change-me-strong-root-password  # REQUIRED

# --- Public origin ---
# Your real domain, e.g. https://almalaki.com (the one attached to `frontend`).
CLIENT_ORIGIN=https://your-domain.com

# The SPA calls the API same-origin via this prefix (nginx proxies it to the
# backend). Leave as /api unless you deploy the API on a separate domain.
VITE_API_BASE_URL=/api

# Base URL the backend puts in image URLs it returns. Keep it identical to
# VITE_API_BASE_URL so uploaded images resolve to the nginx-served path.
API_URL=/api

# --- Auth / cookies (REQUIRED in production) ---
# Must be a strong, unique value >= 16 chars (NOT the example string).
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN_SECONDS=604800
JWT_COOKIE_MAX_AGE_MS=604800000
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# --- Performance ---
# Number of Node worker processes for the API. Node runs JavaScript on one
# thread, so one process uses one core. Leave empty to use every core the
# container is allowed to use (recommended).
WEB_CONCURRENCY=

# Database connections opened per worker. The stack's total is
# WEB_CONCURRENCY x DB_CONNECTION_LIMIT and must stay below MySQL's
# max_connections (151 by default).
DB_CONNECTION_LIMIT=5

# --- Cache ---
CACHE_DEFAULT_TTL_MS=60000

# --- OTP ---
REGISTER_OTP_TTL_IN_SECONDS=300
REGISTER_OTP_MAX_ATTEMPTS=5

# --- SMTP (email: OTP, admin invites) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_FROM=no-reply@almalaki.com
REGISTER_OTP_EMAIL_SUBJECT=Your AL MALAKI verification code
REGISTER_OTP_BRAND_NAME=AL MALAKI

# --- Admin invitations ---
ADMIN_INVITE_TTL_HOURS=48
ADMIN_INVITE_URL_BASE=https://your-domain.com/invite/accept
ADMIN_INVITE_EMAIL_SUBJECT=You're invited to AL MALAKI
ADMIN_INVITE_BRAND_NAME=AL MALAKI

# --- Default admin (seeded on first boot) ---
DEFAULT_ADMIN_EMAIL=admin@almalaki.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_FIRST_NAME=Super
DEFAULT_ADMIN_LAST_NAME=Admin
DEFAULT_ADMIN_PHONE_NUMBER=00000000

# ------------------------------------------------------------------------------
# --- Off-site backups (nightly database + uploads) ---
# The `backup` service dumps MySQL and archives the uploads volume, then pushes
# both to any rclone-supported remote. Cloudflare R2 is used below: its free
# tier includes 10 GB of storage with no egress fees, and it is S3-compatible.
# See DEPLOYMENT.md for how to create the bucket and API token.
# ------------------------------------------------------------------------------

# Destination bucket/path, in the form <remote>:<bucket>. The remote name must
# match the RCLONE_CONFIG_<NAME>_* variables below (here: R2 -> `r2:`).
RCLONE_REMOTE=r2:al-malaki-backups

# Daily run time, 24h UTC.
BACKUP_SCHEDULE_UTC=03:00
# Copies older than this many days are deleted from the remote.
BACKUP_RETENTION_DAYS=14
# Set true to also take one backup immediately on container start (useful to
# verify credentials right after deploying).
BACKUP_RUN_ON_START=false

# Cloudflare R2 credentials (Account -> R2 -> Manage API Tokens).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=your-r2-access-key-id
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
RCLONE_CONFIG_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACL=private
